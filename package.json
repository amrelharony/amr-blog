{
  "name": "fintech-bilinguals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "dompurify": "^3.4.12",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "next": "16.2.12",
    "pdfjs-dist": "6.0.227",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.5"
  },
  "comments": {
    "overrides": [
      "CI gates on `npm audit --audit-level=high --omit=dev`. next pins postcss to an exact",
      "patch and sharp to a caret range that upstream has not yet moved off, so both stay",
      "on versions with high advisories (postcss sourceMappingURL path traversal; sharp's",
      "inherited libvips CVEs). Both bumps are same-major and API-compatible. Drop an entry",
      "once next's own dependency range covers the patched version."
    ]
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
